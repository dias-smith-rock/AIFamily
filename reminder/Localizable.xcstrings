    "创建新群组，或通过邀请码加入他人已有的空间。" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ مجموعة جديدة أو انضم إلى المساحة الحالية لشخص آخر باستخدام رمز الدعوة."
          }
        },
