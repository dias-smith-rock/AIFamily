          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको WeFamily समूह में शामिल होने के लिए आमंत्रित किया गया है! यह निमंत्रण कोड कॉपी करें: %1$@, या ऐप में QR कोड स्कैन करें।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você foi convidado a entrar em um grupo WeFamily! Copie este código de convite: %1$@, ou escaneie o QR code no app."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WeFamily குழுவில் சேர அழைக்கப்பட்டுள்ளீர்கள்! இந்த அழைப்புக் குறியீட்டை நகலெடுக்கவும்: %1$@, அல்லது ஆப்ஸில் QR குறியீட்டை ஸ்கேன் செய்யவும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邀请你加入家音群组空间！请复制此邀请码：%1$@，或使用 App 扫码加入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "邀請你加入家音群組空間！請複製此邀請碼：%1$@，或使用 App 掃碼加入。"
          }
        }
      }
    },
