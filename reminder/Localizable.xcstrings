    "当前待办均已逾期，请从右上角入口查看。" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جميع المهام متأخرة. اضغط الزر أعلى اليمين للعرض."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All open to-dos are overdue. Tap the button at the top right to review them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las tareas pendientes están vencidas. Tócalas arriba a la derecha para revisarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les tâches sont en retard. Appuyez en haut à droite pour les voir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी कार्य अतिदेय हैं। ऊपर दाएँ बटन से देखें।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as tarefas estão atrasadas. Toque no botão no canto superior direito."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அனைத்து பணிகளும் காலாவதியாகியுள்ளன. மேல் வலதில் உள்ள பொத்தானைத் தட்டவும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前待办均已逾期，请从右上角入口查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前待辦均已逾期，請從右上角入口查看。"
          }
        }
      }
    },
