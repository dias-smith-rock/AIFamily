    "此操作不可撤销。" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
