        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet événement a été synchronisé depuis un calendrier externe et ne peut pas être modifié dans l'app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह इवेंट बाहरी कैलेंडर से सिंक किया गया था और ऐप में संपादित नहीं किया जा सकता।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este evento foi sincronizado de um calendário externo e não pode ser editado no app."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த நிகழ்வு வெளி காலெண்டரிலிருந்து ஒத்திசைக்கப்பட்டது; பயன்பாட்டில் திருத்த முடியாது."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此日程由外部同步，暂不支持在应用内修改"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此日程由外部同步，暫不支援在應用程式內修改"
          }
        }
      }
    },
    "This group does not exist or has been deleted. Please refresh and try again." : {
