          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस एक्शन को वापस नहीं किया जा सकता।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ação não pode ser desfeita."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தச் செயலைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
