    "让对方使用家音 App 扫码，或输入下方邀请码即可加入。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب من الطرف الآخر استخدام تطبيق WeFamily لمسح الرمز ضوئيًا، أو إدخال رمز الدعوة أدناه للانضمام."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask the other party to use the WeFamily App to scan the code, or enter the invitation code below to join."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pídale a la otra parte que use la aplicación WeFamily para escanear el código o ingrese el código de invitación a continuación para unirse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à l'autre partie d'utiliser l'application WeFamily pour scanner le code, ou entrez le code d'invitation ci-dessous pour vous joindre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरे पक्ष से कोड स्कैन करने के लिए WeFamily ऐप का उपयोग करने के लिए कहें, या शामिल होने के लिए नीचे निमंत्रण कोड दर्ज करें।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça à outra parte para usar o aplicativo WeFamily para escanear o código ou insira o código de convite abaixo para participar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "குறியீட்டை ஸ்கேன் செய்ய WeFamily ஆப்ஸைப் பயன்படுத்தும்படி மற்ற தரப்பினரிடம் கேட்கவும் அல்லது சேர்வதற்கு கீழே உள்ள அழைப்புக் குறியீட்டை உள்ளிடவும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让对方使用家音 App 扫码，或输入下方邀请码即可加入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請對方使用家音 App 掃碼，或輸入下方邀請碼即可加入。"
          }
        }
      }
    },
    "记得在周六上午检查冰箱库存，并同步更新本周的共享购物清单。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذكر التحقق من مخزون ثلاجتك صباح يوم السبت ومزامنتها مع قائمة التسوق المشتركة لهذا الأسبوع."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remember to check your refrigerator inventory on Saturday morning and sync up with your shared shopping list for the week."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuerde revisar el inventario de su refrigerador el sábado por la mañana y sincronizarlo con su lista de compras compartida de la semana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'oubliez pas de vérifier l'inventaire de votre réfrigérateur le samedi matin et de vous synchroniser avec votre liste de courses partagée pour la semaine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शनिवार की सुबह अपने रेफ्रिजरेटर की सूची की जांच करना और सप्ताह के लिए अपनी साझा खरीदारी सूची के साथ समन्वय करना याद रखें।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembre-se de verificar o estoque de sua geladeira no sábado de manhã e sincronizar sua lista de compras compartilhada da semana."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சனிக்கிழமை காலை உங்கள் குளிர்சாதனப் பெட்டி இருப்பை சரிபார்த்து, வாரத்திற்கான உங்கள் பகிரப்பட்ட ஷாப்பிங் பட்டியலுடன் ஒத்திசைக்கவும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记得在周六上午检查冰箱库存，并同步更新本周的共享购物清单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記得在周六上午檢查冰箱庫存，並同步更新本週的共享購物清單。"
          }
        }
      }
    },
