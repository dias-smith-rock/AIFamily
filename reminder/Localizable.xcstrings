    "网络连接错误。请检查您的连接并重试。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطأ في الاتصال بالشبكة. يرجى التحقق من اتصالك والمحاولة مرة أخرى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Network connection error. Please check your connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error de conexión de red. Por favor verifique su conexión e inténtelo nuevamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreur de connexion réseau. Veuillez vérifier votre connexion et réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क कनेक्शन त्रुटि. अपने कनेक्शन की जांच करें और पुन: प्रयास करें।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erro de conexão de rede. Verifique sua conexão e tente novamente."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பிணைய இணைப்பு பிழை. உங்கள் இணைப்பைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络连接错误。请检查您的连接并重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網路連線錯誤。請檢查您的連線並重試。"
          }
        }
      }
    },
