    "仅当位移超过所选阈值，且距上次上报超过所选间隔时，才会写入云端位置。" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحفظ موقعك في السحابة فقط عند تحقق حد الإزاحة وفترة الإبلاغ معًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is saved only when both the movement threshold and report interval are met."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ubicación solo se guarda cuando se cumplen el umbral de desplazamiento y el intervalo de informe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre position n'est enregistrée que lorsque le seuil de déplacement et l'intervalle sont respectés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थान तभी क्लाउड में सहेजा जाता है जब स्थानांतरण सीमा और रिपोर्ट अंतराल दोनों पूरे हों।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua localização só é salva quando o limite de deslocamento e o intervalo de relatório são atendidos."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இடப்பெயர்வு வரம்பும் அறிக்கை இடைவெளியும் பூர்த்தியாகும்போது மட்டுமே இருப்பிடம் கிளவுடில் சேமிக்கப்படும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当位移超过所选阈值，且距上次上报超过所选间隔时，才会写入云端位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅當位移超過所選閾值，且距上次上報超過所選間隔時，才會寫入雲端位置。"
          }
        }
      }
    },
