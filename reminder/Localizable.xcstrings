    "添加没有具体开始时间的任务，在截止日前完成即可。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضِف مهامًا بلا وقت بدء محدد—أنجزها قبل الموعد النهائي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add tasks without a set start time—complete them before the due date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tareas sin hora de inicio; complétalas antes de la fecha límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des tâches sans heure de début—à terminer avant la date limite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना शुरुआती समय के कार्य जोड़ें—अंतिम तिथि से पहले पूरा करें।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione tarefas sem horário de início—conclua-as antes do prazo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தொடக்க நேரம் இல்லாத பணிகளைச் சேர்க்கவும்—காலக்கெடுவுக்கு முன் முடிக்கவும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加没有具体开始时间的任务，在截止日前完成即可。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增沒有具體開始時間的任務，在截止日前完成即可。"
          }
        }
      }
    },
    "添加第一位成员，一起分工协作、温柔提醒每一天。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف العضو الأول لتقسيم العمل والتعاون معًا، وتقديم تذكيرات لطيفة كل يوم."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the first member to divide the work and collaborate together, and provide gentle reminders every day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregue al primer miembro para dividir el trabajo y colaborar juntos, y proporcione recordatorios amables todos los días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez le premier membre pour diviser le travail et collaborer ensemble, et fournissez des rappels doux chaque jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार्य को विभाजित करने और एक साथ सहयोग करने के लिए पहले सदस्य को जोड़ें, और हर दिन धीरे-धीरे अनुस्मारक प्रदान करें।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione o primeiro membro para dividir o trabalho e colaborar juntos, além de fornecer lembretes gentis todos os dias."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வேலையைப் பிரித்து ஒன்றாக ஒத்துழைக்க முதல் உறுப்பினரைச் சேர்த்து, ஒவ்வொரு நாளும் மென்மையான நினைவூட்டல்களை வழங்கவும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加第一位成员，一起分工协作、温柔提醒每一天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "增加第一位成員，一起分工協作、溫柔提醒每一天。"
          }
        }
      }
    },
