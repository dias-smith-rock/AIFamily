    "自然语言修正：例如“时间改成明天下午”" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصحيح اللغة الطبيعية: على سبيل المثال. \"تغيير الوقت إلى بعد ظهر الغد\""
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natural language correction: e.g. \"Change the time to tomorrow afternoon\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrección del lenguaje natural: p.e. \"Cambiar la hora a mañana por la tarde\""
          }
        },
        "fr" : {
          "stringUnit" : {
