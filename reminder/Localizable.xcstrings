    "No phone number needed—you can record tasks on their behalf (great for kids or elders)." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا حاجة لرقم هاتف—يمكنك تسجيل المهام نيابة عنهم (مناسب للأطفال أو كبار السن)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No phone number needed—you can record tasks on their behalf (great for kids or elders)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se necesita número de teléfono: puedes registrar tareas en su nombre (ideal para niños o mayores)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas besoin de numéro de téléphone—enregistrez des tâches pour eux (idéal pour les enfants ou les aînés)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोन नंबर की ज़रूरत नहीं—आप उनकी ओर से कार्य दर्ज कर सकते हैं (बच्चों या बुजुर्गों के लिए उपयुक्त)।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem número de telefone—você pode registrar tarefas em nome deles (ideal para crianças ou idosos)."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தொலைபேசி எண் தேவையில்லை—நீங்கள் அவர்களுக்காக பணிகளை பதிவு செய்யலாம் (குழந்தைகள் அல்லது முதியவர்களுக்கு ஏற்றது)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需手机号，由您直接替 Ta 记录任务（适合小孩子或长辈）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無需手機號，由您直接替 Ta 記錄任務（適合小孩子或長輩）。"
          }
        }
      }
    },
