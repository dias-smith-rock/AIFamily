    "促销权益须由服务端发放，客户端无法直接领取。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب منح المزايا الترويجية من الخادم؛ لا يمكن المطالبة بها مباشرة في التطبيق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promotional benefits must be granted by the server; they cannot be claimed directly in the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los beneficios promocionales deben concederse desde el servidor; no se pueden reclamar directamente en la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les avantages promotionnels doivent être accordés par le serveur ; ils ne peuvent pas être réclamés directement dans l'app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रचार लाभ सर्वर द्वारा दिए जाने चाहिए; ऐप में सीधे दावा नहीं किया जा सकता।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benefícios promocionais devem ser concedidos pelo servidor; não podem ser reivindicados diretamente no app."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விளம்பர சலுகைகள் சேவையகத்தால் வழங்கப்பட வேண்டும்; பயன்பாட்டில் நேரடியாக கோர முடியாது."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "促销权益须由服务端发放，客户端无法直接领取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "促銷權益須由服務端發放，客戶端無法直接領取。"
          }
        }
      }
    },
