          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த அழைப்புக் குறியீடு காலாவதியானது. புதிய ஒன்றைப் பகிருமாறு படைப்பாளரிடம் கேட்கவும்."
