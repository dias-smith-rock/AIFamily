    "灵活待办不支持批量更新重复任务。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المهام المرنة لا تدعم التحديث الجماعي للسلسلة المتكررة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flexible to-dos can't be batch-updated as a recurring series."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tareas flexibles no admiten actualización masiva de series recurrentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tâches flexibles ne prennent pas en charge la mise à jour groupée des séries récurrentes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लचीले कार्य आवर्ती श्रृंखला का बैच अपडेट समर्थित नहीं करते।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarefas flexíveis não suportam atualização em lote de séries recorrentes."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நெகிழ்வான பணிகள் தொடர் பணிகளை மொத்தமாகப் புதுப்பிக்க முடியாது."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灵活待办不支持批量更新重复任务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "靈活待辦不支援批量更新重複任務。"
          }
        }
      }
    },
    "灵活待办不支持重复规则。" : {
