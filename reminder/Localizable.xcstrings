        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sig-ஐ ஒட்டிய பிறகு, 200/409/410 நிலையை விரைவாகச் சரிபார்க்க நுகர்வோர்-அழைப்பு-இணைப்பை அழைக்கவும்."
          }
