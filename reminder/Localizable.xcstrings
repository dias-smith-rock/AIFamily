    "检测到你加入了多个群组，请选择本次要进入的群组。" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم اكتشاف أنك انضممت إلى مجموعات متعددة. الرجاء تحديد المجموعة التي تريد الانضمام إليها هذه المرة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is detected that you have joined multiple groups. Please select the group you want to join this time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detecta que te has unido a varios grupos. Seleccione el grupo al que desea unirse esta vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est détecté que vous avez rejoint plusieurs groupes. Veuillez sélectionner le groupe que vous souhaitez rejoindre cette fois-ci."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पता चला है कि आप कई समूहों में शामिल हो गए हैं। कृपया उस समूह का चयन करें जिसमें आप इस बार शामिल होना चाहते हैं।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É detectado que você ingressou em vários grupos. Selecione o grupo ao qual deseja ingressar desta vez."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் பல குழுக்களில் இணைந்திருப்பது கண்டறியப்பட்டது. இந்த நேரத்தில் நீங்கள் சேர விரும்பும் குழுவைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到你加入了多个群组，请选择本次要进入的群组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偵測到你加入了多個群組，請選擇本次要進入的群組。"
          }
        }
      }
    },
    "检测到当前会话无效，请先登录再加载群组成员。" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم اكتشاف أن الجلسة الحالية غير صالحة. الرجاء تسجيل الدخول أولا ثم تحميل أعضاء المجموعة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It is detected that the current session is invalid. Please log in first and then load group members."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detecta que la sesión actual no es válida. Inicie sesión primero y luego cargue los miembros del grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est détecté que la session en cours n'est pas valide. Veuillez d'abord vous connecter, puis charger les membres du groupe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह पता चला है कि वर्तमान सत्र अमान्य है. कृपया पहले लॉग इन करें और फिर समूह सदस्यों को लोड करें।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É detectado que a sessão atual é inválida. Faça login primeiro e depois carregue os membros do grupo."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தற்போதைய அமர்வு தவறானது என்று கண்டறியப்பட்டது. முதலில் உள்நுழைந்து பின்னர் குழு உறுப்பினர்களை ஏற்றவும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到当前会话无效，请先登录再加载群组成员。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偵測到目前會話無效，請先登入再載入群組成員。"
          }
        }
      }
    },
