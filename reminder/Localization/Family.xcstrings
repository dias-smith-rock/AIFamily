    "family_no_group_caps_connect_every_circle_of_your_life": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حدود للمجموعات — اربط دوائر حياتك بعدد غير محدود من الأعضاء."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No group caps—connect every circle of your life with unlimited members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin límites de grupos: conecta todos tus círculos con miembros ilimitados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de limite de groupes — reliez tous vos cercles avec des membres illimités."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह सीमा नहीं — असीमित सदस्यों के साथ अपने सभी सर्कल जोड़ें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem limites de grupos — conecte todos os seus círculos com membros ilimitados."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குழு வரம்பு இல்லை — வரம்பற்ற உறுப்பினர்களுடன் உங்கள் வாழ்க்கை வட்டங்களை இணைக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打破建群上限，支持容纳无限成员，连接你的多重生活圈。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打破建群上限，支援容納無限成員，連結你的多重生活圈。"
          }
        }
      }
    },
