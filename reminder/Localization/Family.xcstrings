    "family_up_to_1_group_2_members_per_group": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يصل إلى مجموعة واحدة، عضوين لكل مجموعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 1 group, 2 members per group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta 1 grupo, 2 miembros por grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'à 1 groupe, 2 membres par groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 समूह तक, प्रति समूह 2 सदस्य।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até 1 grupo, 2 membros por grupo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "1 குழு வரை, ஒரு குழுவிற்கு 2 உறுப்பினர்கள்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 1 个群组，每组上限 2 人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 1 個群組，每組上限 2 人。"
          }
        }
      }
    },
    "family_while_hidden_group_members_cannot_see_your_locat": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أثناء الإخفاء، لا يمكن لأعضاء المجموعة رؤية موقعك على الخريطة ولن تُرسل إحداثيات جديدة إلى الخادم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While hidden, group members cannot see your location on the map, and new coordinates are not sent to the server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras esté oculta, los miembros del grupo no verán tu ubicación en el mapa y no se enviarán nuevas coordenadas al servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous êtes masqué, les membres du groupe ne voient pas votre position sur la carte et aucune nouvelle coordonnée n'est envoyée au serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छिपे रहने पर समूह के सदस्य मानचित्र पर आपका स्थान नहीं देख पाएंगे और नए निर्देशांक सर्वर पर नहीं भेजे जाएंगे।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto oculto, os membros do grupo não verão sua localização no mapa e novas coordenadas não serão enviadas ao servidor."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மறைத்திருக்கும் போது, குழு உறுப்பினர்கள் வரைபடத்தில் உங்கள் இடத்தைக் காண முடியாது; புதிய ஆயத்தொலைவுகள் சேவையகத்திற்கு அனுப்பப்படாது."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐身期间，群组成员无法在地图上看到你的位置，且不会向服务器上报新坐标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱身期間，群組成員無法在地圖上看到你的位置，且不會向伺服器上報新座標。"
          }
        }
      }
    },
    "family_you_are_already_a_member_of_this_group": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت بالفعل عضو في هذه المجموعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are already a member of this group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya eres miembro de este grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes déjà membre de ce groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप पहले से ही इस समूह के सदस्य हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já é membro deste grupo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் ஏற்கனவே இந்த குழுவின் உறுப்பினர்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已经加入了该群组，无需重复添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已經加入了該群組，無需重複新增。"
          }
        }
      }
    },
    "family_you_are_the_creator_of_2_lld_group_s_including_1": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت منشئ %@ و%lld مجموعات أخرى. يُرجى نقل الملكية أو حلّ تلك المجموعات قبل حذف حسابك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are the creator of %2$lld group(s) including '%1$@'. Please transfer ownership or dismiss the groups before deleting your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres el creador de %@ y de %lld grupos más. Transfiere la propiedad o disuelve esos grupos antes de eliminar tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes le créateur de %@ et de %lld autres groupes. Veuillez transférer la propriété ou dissoudre ces groupes avant de supprimer votre compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप %@ सहित %lld अन्य समूहों के निर्माता हैं। कृपया खाता हटाने से पहले स्वामित्व स्थानांतरित करें या उन समूहों को भंग करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é o criador de %@ e de mais %lld grupos. Transfira a propriedade ou dissolva esses grupos antes de excluir sua conta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் %@ உட்பட மேலும் %lld குழுக்களின் உருவாக்குநர். கணக்கை நீக்குவதற்கு முன் உரிமையை மாற்றவும் அல்லது அந்தக் குழுக்களை கலைக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您是「%@」等 %lld 个群组的创建者，请先转移权限或解散群组后再注销账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您是「%@」等 %lld 個群組的創建者，請先轉移權限或解散群組後再登出帳戶。"
          }
        }
      }
    },
    "family_you_are_the_creator_of_this_group_please_transfe": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت منشئ هذه المجموعة. يرجى نقل الأذونات أو حل المجموعة قبل الخروج."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are the creator of this group. Please transfer permissions or dissolve the group before exiting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres el creador de este grupo. Transfiera los permisos o disuelva el grupo antes de salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes le créateur de ce groupe. Veuillez transférer les autorisations ou dissoudre le groupe avant de quitter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इस समूह के निर्माता हैं. कृपया बाहर निकलने से पहले अनुमतियाँ स्थानांतरित करें या समूह को भंग कर दें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é o criador deste grupo. Transfira as permissões ou dissolva o grupo antes de sair."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் குழுவை உருவாக்கியவர் நீங்கள். வெளியேறும் முன் அனுமதிகளை மாற்றவும் அல்லது குழுவை கலைக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您是该群组的创建者，请先转移权限或解散群组后再退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您是該群組的創建者，請先轉移權限或解散群組後再退出。"
          }
        }
      }
    },
    "family_you_are_the_creator_of_this_group_transfer_owner": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت منشئ هذه المجموعة. انقل الملكية أو قم بحل المجموعة قبل المغادرة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are the creator of this group. Transfer ownership or disband the group before leaving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres el creador de este grupo. Transfiere la propiedad o disuelve el grupo antes de salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes le créateur de ce groupe. Transférez la propriété ou dissolvez le groupe avant de partir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इस समूह के निर्माता हैं। छोड़ने से पहले स्वामित्व स्थानांतरित करें या समूह भंग करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é o criador deste grupo. Transfira a propriedade ou dissolva o grupo antes de sair."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இந்த குழுவின் உருவாக்குநர். வெளியேறுவதற்கு முன் உரிமையை மாற்றவும் அல்லது குழுவை கலைக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您是此群组的创建者。退出前请先转移所有权或解散群组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您是此群組的建立者。退出前請先轉移所有權或解散群組。"
          }
        }
      }
    },
    "family_you_do_not_have_permission_to_edit_this_member_p": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لديك إذن لتعديل ملف هذا العضو."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not have permission to edit this member profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes permiso para editar este perfil de miembro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez pas l'autorisation de modifier ce profil membre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको इस सदस्य प्रोफ़ाइल को संपादित करने की अनुमति नहीं है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não tem permissão para editar este perfil de membro."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உறுப்பினர் சுயவிவரத்தை திருத்த உங்களுக்கு அனுமதி இல்லை."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有权限修改该成员资料。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有權限修改該成員資料。"
          }
        }
      }
    },
    "family_you_don_t_have_permission_to_change_this_member": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لديك إذن لتغيير دور المسؤول لهذا العضو."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to change this member's admin role."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes permiso para cambiar el rol de administrador de este miembro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez pas l'autorisation de modifier le rôle d'administrateur de ce membre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास इस सदस्य की व्यवस्थापक भूमिका बदलने की अनुमति नहीं है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não tem permissão para alterar a função de administrador deste membro."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உறுப்பினரின் நிர்வாகி பங்கை மாற்ற உங்களுக்கு அனுமதி இல்லை."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有权限修改该成员的管理员身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有權限修改該成員的管理員身份。"
          }
        }
      }
    },
    "family_you_don_t_have_permission_to_remove_or_delete_th": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليس لديك الإذن بإزالة هذا العضو أو حذفه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to remove or delete this member."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes permiso para eliminar o eliminar a este miembro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'êtes pas autorisé à supprimer ou supprimer ce membre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास इस सदस्य को हटाने या हटाने की अनुमति नहीं है."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não tem permissão para remover ou excluir este membro."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த உறுப்பினரை அகற்றவோ நீக்கவோ உங்களுக்கு அனுமதி இல்லை."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有权限移出或删除该成员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有權限移出或刪除該成員。"
          }
        }
      }
    },
    "family_you_have_become_the_creator_of_and_have_the_high": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد أصبحت منشئ \"%@\" وتتمتع بأعلى الحقوق الإدارية لهذه المجموعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have become the creator of \"%@\" and have the highest administrative rights for this group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te has convertido en el creador de \"%@\" y tienes los derechos administrativos más altos para este grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes devenu le créateur de \"%@\" et disposez des droits administratifs les plus élevés pour ce groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप \"%@\" के निर्माता बन गए हैं और इस समूह के लिए आपके पास सर्वोच्च प्रशासनिक अधिकार हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você se tornou o criador do \"%@\" e possui os mais altos direitos administrativos para este grupo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் \"%@\" ஐ உருவாக்கி, இந்தக் குழுவிற்கான மிக உயர்ந்த நிர்வாக உரிமைகளைப் பெற்றுள்ளீர்கள்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已成为「%@」的创建者，拥有该群组的最高管理权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已成為「%@」的創建者，擁有該群組的最高管理權限。"
          }
        }
      }
    },
    "family_you_haven_t_joined_any_groups_yet": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تنضم إلى أي مجموعات حتى الآن"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't joined any groups yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no te has unido a ningún grupo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez encore rejoint aucun groupe"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अभी तक किसी भी समूह में शामिल नहीं हुए हैं"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não entrou em nenhum grupo"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் இதுவரை எந்தக் குழுக்களிலும் சேரவில்லை"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您还没有加入任何群组"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您還沒有加入任何群組"
          }
        }
      }
    },
    "family_you_re_invited_to_join_a_wesync_group_copy_this": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت مدعو للانضمام إلى مجموعة WeSync! انسخ رمز الدعوة: %1$@، أو امسح رمز QR في التطبيق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're invited to join a WeSync group! Copy this invite code: %1$@, or scan the QR code in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Te invitan a unirte a un grupo de WeSync! Copia este código de invitación: %1$@, o escanea el código QR en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes invité à rejoindre un groupe WeSync ! Copiez ce code d'invitation : %1$@, ou scannez le QR code dans l'app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको WeSync समूह में शामिल होने के लिए आमंत्रित किया गया है! यह निमंत्रण कोड कॉपी करें: %1$@, या ऐप में QR कोड स्कैन करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você foi convidado a entrar em um grupo WeSync! Copie este código de convite: %1$@, ou escaneie o QR code no app."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "WeSync குழுவில் சேர அழைக்கப்பட்டுள்ளீர்கள்! இந்த அழைப்புக் குறியீட்டை நகலெடுக்கவும்: %1$@, அல்லது ஆப்ஸில் QR குறியீட்டை ஸ்கேன் செய்யவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请你加入同圈群组空间！请复制此邀请码：%1$@，或使用 App 扫码加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邀請你加入同圈群組空間！請複製此邀請碼：%1$@，或使用 App 掃碼加入。"
          }
        }
      }
    },
    "family_your_feedback_helps_us_improve_the_app_for_group": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملاحظاتك تساعدنا على تحسين التطبيق للمجموعات والفرق. هل تود ترك تقييم سريع؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your feedback helps us improve the app for groups and teams. Would you mind leaving a quick review?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu opinión nos ayuda a mejorar la app para grupos y equipos. ¿Podrías dejar una reseña rápida?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos retours nous aident à améliorer l'app pour les groupes et les équipes. Pourriez-vous laisser un avis rapide ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी प्रतिक्रिया समूहों और टीमों के लिए ऐप को बेहतर बनाने में मदद करती है। क्या आप एक समीक्षा छोड़ सकते हैं?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu feedback ajuda-nos a melhorar a app para grupos e equipas. Pode deixar uma avaliação rápida?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உங்கள் கருத்து குழுக்களுக்கும் அணிகளுக்கும் செயலியை மேம்படுத்த உதவுகிறது. ஒரு மதிப்புரை விடுவீர்களா?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的反馈能帮助我们为群组和团队把应用做得更好。愿意花一点时间留个评价吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的回饋能幫助我們為群組與團隊把應用做得更好。願意花一點時間留個評價嗎？"
          }
        }
      }
    },
