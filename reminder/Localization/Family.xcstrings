    "family_the_selected_member_cannot_receive_ownership_ple": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن للعضو المحدد الحصول على الملكية. الرجاء الاختيار مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected member cannot receive ownership. Please choose again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El miembro seleccionado no puede recibir la propiedad. Por favor elige de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le membre sélectionné ne peut pas recevoir la propriété. Veuillez choisir à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित सदस्य को स्वामित्व प्राप्त नहीं हो सकता. कृपया पुनः चुनें."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O membro selecionado não pode receber propriedade. Por favor, escolha novamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தேர்ந்தெடுக்கப்பட்ட உறுப்பினர் உரிமையைப் பெற முடியாது. மீண்டும் தேர்வு செய்யவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选成员不符合接收权限的条件，请重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選成員不符合接收權限的條件，請重新選擇。"
          }
        }
      }
    },
    "family_there_are_no_other_active_account_members_who_ca": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد حاليًا أي أعضاء حساب نشطين آخرين يمكنهم الحصول على الأذونات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no other active account members who can receive ownership."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualmente no hay otros miembros activos de la cuenta que puedan recibir permisos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a actuellement aucun autre membre actif du compte qui peut recevoir des autorisations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान में कोई अन्य सक्रिय खाता सदस्य नहीं है जो अनुमतियाँ प्राप्त कर सके।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualmente não há outros membros ativos da conta que possam receber permissões."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனுமதிகளைப் பெறக்கூடிய செயலில் உள்ள கணக்கு உறுப்பினர்கள் யாரும் தற்போது இல்லை."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有其他可接收权限的有效账号成员。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有其他可接收權限的有效帳號成員。"
          }
        }
      }
    },
    "family_they_will_return_to_regular_member_permissions": {
      "localizations": {
        "ar": {
