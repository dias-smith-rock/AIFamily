    "family_invalid_invite_code_format_must_be_6_letters_or": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنسيق رمز الدعوة غير صالح: يجب أن يتكون من 6 أحرف أو أرقام."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid invite code format: must be 6 letters or digits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato de código de invitación no válido: debe tener 6 letras o dígitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format du code d'invitation non valide : doit contenir 6 lettres ou chiffres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अमान्य आमंत्रण कोड प्रारूप: 6 अक्षर या अंक होना चाहिए।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato de código de convite inválido: deve ter 6 letras ou dígitos."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தவறான அழைப்புக் குறியீடு வடிவம்: 6 எழுத்துகள் அல்லது இலக்கங்கள் இருக்க வேண்டும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请码格式无效：必须为 6 位字母或数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邀請碼格式無效：必須為 6 位字母或數字。"
          }
        }
      }
    },
    "family_invalid_invite_code_please_check_and_try_again": {
      "localizations": {
