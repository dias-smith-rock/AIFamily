      }
    },
    "family_this_group_does_not_exist_or_has_been_deleted_pl": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المجموعة غير موجودة أو تم حذفها. يرجى التحديث والمحاولة مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This group does not exist or has been deleted. Please refresh and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo no existe o fue eliminado. Actualiza e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce groupe n'existe pas ou a été supprimé. Actualisez et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह समूह मौजूद नहीं है या हटा दिया गया है। कृपया रीफ़्रेश करके पुनः प्रयास करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo não existe ou foi excluído. Atualize e tente novamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த குழு இல்லை அல்லது நீக்கப்பட்டது. புதுப்பித்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群组不存在或已被删除，请刷新后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "群組不存在或已被刪除，請重新整理後再試。"
          }
        }
      }
    },
    "family_this_group_name_is_already_taken_please_choose_a": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المجموعة مستخدم بالفعل. يرجى اختيار اسم آخر."
          }
        },
        "en": {
          "stringUnit": {
