    "family_could_not_load_membership_after_migration_please": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الحصول على عضوية المجموعة بعد الترحيل. حاول لاحقًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load membership after migration. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener la membresía tras la migración. Inténtalo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'obtenir l'appartenance au groupe après la migration. Réessayez plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइग्रेशन के बाद सदस्यता प्राप्त नहीं हो सकी। बाद में पुनः प्रयास करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter a associação após a migração. Tente novamente mais tarde."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடமாற்றத்திற்குப் பிறகு உறுப்பினர் அடையாளம் கிடைக்கவில்லை. பின்னர் முயற்சிக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "迁移后未能获取群组成员身份，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遷移後未能取得群組成員身分，請稍後重試。"
          }
        }
      }
    },
    "family_create_a_new_group_or_join_someone_else_s_existi": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ مجموعة جديدة أو انضم إلى المساحة الحالية لشخص آخر باستخدام رمز الدعوة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new group or join someone else's existing space with an invitation code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un nuevo grupo o únete al espacio existente de otra persona con un código de invitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un nouveau groupe ou rejoignez l'espace existant de quelqu'un d'autre avec un code d'invitation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नया समूह बनाएं या आमंत्रण कोड के साथ किसी और के मौजूदा स्थान में शामिल हों।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um novo grupo ou entre no espaço existente de outra pessoa com um código de convite."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புதிய குழுவை உருவாக்கவும் அல்லது அழைப்பிதழ் குறியீட்டுடன் வேறொருவரின் தற்போதைய இடத்தில் சேரவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建新群组，或通过邀请码加入他人已有的空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立新群組，或透過邀請碼加入他人已有的空間。"
          }
        }
      }
    },
