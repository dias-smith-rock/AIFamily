        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该群组不存在或已被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該群組不存在或已被刪除。"
          }
