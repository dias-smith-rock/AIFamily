    "family_one_renewal_covers_everyone_group_members_seamle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجديد واحد يغطي الجميع — يشارك أعضاء المجموعة جميع المزايا المميزة بسلاسة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One renewal covers everyone—group members seamlessly share all premium perks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una renovación cubre a todos: los miembros del grupo comparten todas las ventajas Premium."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un renouvellement couvre tout le monde — les membres du groupe partagent tous les avantages Premium."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नवीनीकरण सभी को कवर करता है — समूह सदस्य सभी प्रीमियम सुविधाएँ सहज साझा करते हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma renovação cobre todos — membros do grupo compartilham todos os benefícios Premium."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒரு புதுப்பிப்பு அனைவரையும் உள்ளடக்கும் — குழு உறுப்பினர்கள் பிரீமியம் சலுகைகளைப் பகிர்வர்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一人续费承包全组，群组成员无缝共享全部高级特权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一人續費承包全組，群組成員無縫共享全部高級特權。"
          }
        }
      }
    },
    "family_only_the_creator_can_disband_this_group": {
      "localizations": {
