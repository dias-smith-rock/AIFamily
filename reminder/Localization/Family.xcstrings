          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce nom de groupe est déjà pris. Veuillez en choisir un autre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह समूह नाम पहले से लिया गया है। कृपया दूसरा नाम चुनें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este nome de grupo já está em uso. Escolha outro."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த குழுப் பெயர் ஏற்கனவே உள்ளது. வேறு பெயரைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该群组名称已被占用，请换一个名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該群組名稱已被使用，請換一個名稱。"
          }
        }
      }
    },
    "family_this_invite_code_has_expired_please_ask_the_crea": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد انتهت صلاحية رمز الدعوة هذا. من فضلك اطلب من المبدع مشاركة واحدة جديدة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This invite code has expired. Please ask the creator to share a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código de invitación ha caducado. Pídale al creador que comparta uno nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code d'invitation a expiré. Veuillez demander au créateur d'en partager un nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आमंत्रण कोड समाप्त हो गया है. कृपया निर्माता से एक नया साझा करने के लिए कहें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código de convite expirou. Por favor, peça ao criador para compartilhar um novo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த அழைப்புக் குறியீடு காலாவதியானது. புதிய ஒன்றைப் பகிருமாறு படைப்பாளரிடம் கேட்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该邀请码已过期。请创建者分享一个新的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該邀請碼已過期。請創建者分享一個新的。"
          }
        }
      }
    },
