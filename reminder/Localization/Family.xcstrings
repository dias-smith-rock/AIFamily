{
  "sourceLanguage": "en",
  "strings": {
    "family_add_group_members": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إضافة أعضاء المجموعة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add group members"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregar miembros del grupo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter des membres du groupe"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह के सदस्यों को जोड़ें"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar membros do grupo"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குழு உறுப்பினர்களைச் சேர்க்கவும்"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加群组成员"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增群組成員"
          }
        }
      }
    },
    "family_admins_can_help_manage_group_members_and_setting": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للمسؤولين المساعدة في إدارة أعضاء المجموعة وإعداداتها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Admins can help manage group members and settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los administradores pueden ayudar a gestionar miembros y ajustes del grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les administrateurs peuvent aider à gérer les membres et les réglages du groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यवस्थापक समूह सदस्यों और सेटिंग्स प्रबंधित करने में मदद कर सकते हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Administradores podem ajudar a gerir membros e definições do grupo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நிர்வாகிகள் குழு உறுப்பினர்களையும் அமைப்புகளையும் நிர்வகிக்க உதவலாம்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为管理员后，该成员可以协助管理群组成员与设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設為管理員後，該成員可以協助管理群組成員與設定。"
          }
        }
      }
    },
    "family_after_approval_you_will_automatically_enter_the": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الموافقة، ستدخل تلقائيًا إلى الواجهة الرئيسية للمجموعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After approval, you will automatically enter the main interface of the group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de la aprobación, ingresará automáticamente a la interfaz principal del grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après approbation, vous entrerez automatiquement dans l’interface principale du groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमोदन के बाद, आप स्वचालित रूप से समूह के मुख्य इंटरफ़ेस में प्रवेश करेंगे।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a aprovação, você entrará automaticamente na interface principal do grupo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "ஒப்புதலுக்குப் பிறகு, நீங்கள் தானாகவே குழுவின் முக்கிய இடைமுகத்தை உள்ளிடுவீர்கள்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准后你会自动进入群组主界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批准後你會自動進入群組主介面。"
          }
        }
      }
    },
    "family_after_transfer_you_will_become_a_regular_member": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد النقل، سيتم تخفيض رتبتك إلى عضو عادي. سيصبح الطرف المنقول هو المنشئ تلقائيًا دون تأكيد. يرجى الاختيار بعناية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After transfer, you will become a regular member. The recipient becomes the creator automatically with no further confirmation. Choose carefully."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de la transferencia, será degradado a miembro regular. La parte transferida se convertirá automáticamente en el creador sin confirmación. Elija con cuidado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après le transfert, vous serez rétrogradé au rang de membre régulier. La partie transférée deviendra automatiquement le créateur sans confirmation. Veuillez choisir avec soin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानांतरण के बाद, आपको नियमित सदस्य के रूप में पदावनत कर दिया जाएगा। स्थानांतरित पक्ष बिना पुष्टि के स्वचालित रूप से निर्माता बन जाएगा। कृपया ध्यान से चुनें."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a transferência, você será rebaixado a membro regular. A parte transferida se tornará automaticamente o criador sem confirmação. Por favor escolha com cuidado."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடமாற்றத்திற்குப் பிறகு, நீங்கள் வழக்கமான உறுப்பினராக தரமிறக்கப்படுவீர்கள். மாற்றப்பட்ட தரப்பினர் உறுதிப்படுத்தப்படாமல் தானாகவே படைப்பாளராகிவிடுவார்கள். கவனமாக தேர்வு செய்யவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转移后，您将降级为普通成员。被转移方会自动成为创建者，无需确认。请谨慎选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉移後，您將降級為普通成員。被轉移方會自動成為創建者，無需確認。請謹慎選擇。"
          }
        }
      }
    },
    "family_after_you_leave_the_group_will_no_longer_receive": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الخروج، لن يتلقى المجموعة تحديثات موقعك اللحظية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you leave, the group will no longer receive your second-by-second location updates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al salir, el grupo dejará de recibir tus actualizaciones de ubicación en tiempo real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après votre départ, le groupe ne recevra plus vos mises à jour de position en temps réel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाहर निकलने के बाद, समूह आपके सेकंड-दर-सेकंड स्थान अपडेट प्राप्त नहीं करेगा।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao sair, o grupo deixará de receber suas atualizações de localização em tempo real."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெளியேறிய பிறகு, குழு உங்கள் வினாடிக்கு வினாடி இடப் புதுப்பிப்புகளைப் பெறாது."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出后，群组将不再接收你的秒级位置更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退出後，群組將不再接收你的秒級位置更新。"
          }
        }
      }
    },
    "family_and_lld_other_groups": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "و%lld مجموعات أخرى"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " and %lld other groups"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "y %lld otros grupos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "et %lld autres groupes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "और %lld अन्य समूह"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "e %lld outros grupos"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மற்றும் %lld பிற குழுக்கள்"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等 %lld 个群组"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等 %lld 個群組"
          }
        }
      }
    },
    "family_are_you_sure_you_want_to_leave_this_group": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد أنك تريد مغادرة هذه المجموعة؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to leave this group?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que quieres abandonar este grupo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir quitter ce groupe ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई इस समूह को छोड़ना चाहते हैं?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja sair deste grupo?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தக் குழுவிலிருந்து நிச்சயமாக வெளியேற விரும்புகிறீர்களா?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要退出该群组吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要退出該群組嗎？"
          }
        }
      }
    },
    "family_ask_the_other_party_to_use_the_wesync_app_to_sca": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من الطرف الآخر استخدام تطبيق WeSync لمسح الرمز ضوئيًا، أو إدخال رمز الدعوة أدناه للانضمام."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the other party to use the WeSync app to scan the code, or enter the invitation code below to join."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pídale a la otra parte que use la aplicación WeSync para escanear el código o ingrese el código de invitación a continuación para unirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à l'autre partie d'utiliser l'application WeSync pour scanner le code, ou entrez le code d'invitation ci-dessous pour vous joindre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे पक्ष से कोड स्कैन करने के लिए WeSync ऐप का उपयोग करने के लिए कहें, या शामिल होने के लिए नीचे निमंत्रण कोड दर्ज करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça à outra parte para usar o aplicativo WeSync para escanear o código ou insira o código de convite abaixo para participar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குறியீட்டை ஸ்கேன் செய்ய WeSync ஆப்ஸைப் பயன்படுத்தும்படி மற்ற தரப்பினரிடம் கேட்கவும் அல்லது சேர்வதற்கு கீழே உள்ள அழைப்புக் குறியீட்டை உள்ளிடவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让对方使用同圈 App 扫码，或输入下方邀请码即可加入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請對方使用同圈 App 掃碼，或輸入下方邀請碼即可加入。"
          }
        }
      }
    },
    "family_choose_a_group_to_open": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مجموعة لفتحها"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a group to open"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un grupo para abrir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un groupe à ouvrir"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोलने के लिए एक समूह चुनें"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um grupo para abrir"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திறக்க ஒரு குழுவைத் தேர்ந்தெடுக்கவும்"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择您要进入的群组"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇您要進入的群組"
          }
        }
      }
    },
    "family_collapse_group_member_list": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طي قائمة أعضاء المجموعة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapse group member list"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraer lista de miembros"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire la liste des membres"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह सदस्य सूची संक्षिप्त करें"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recolher lista de membros"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குழு உறுப்பினர் பட்டியலை சுருக்கு"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起群组成员列表"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收起群組成員列表"
          }
        }
      }
    },
    "family_confirm_dismiss_group": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكيد حل المجموعة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm Dismiss Group"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar disolución del grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmer la dissolution du groupe"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह के विघटन की पुष्टि करें"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme a dissolução do grupo"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குழுவின் கலைப்பை உறுதிப்படுத்தவும்"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认解散群组"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認解散群組"
          }
        }
      }
    },
    "family_consumption_invitation_link": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رابط دعوة الاستهلاك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "consumption invitation link"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "enlace de invitación de consumo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "lien d'invitation à la consommation"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपभोग आमंत्रण लिंक"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "link de convite de consumo"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நுகர்வு அழைப்பிதழ் இணைப்பு"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消费邀请链接"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "消費邀請連結"
          }
        }
      }
    },
    "family_could_not_join_the_group_please_try_again_later": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الانضمام إلى المجموعة. يرجى المحاولة لاحقًا أو التواصل مع المنشئ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not join the group. Please try again later or contact the creator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo unir al grupo. Inténtelo de nuevo más tarde o contacte al creador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de rejoindre le groupe. Veuillez réessayer plus tard ou contacter le créateur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समूह में शामिल नहीं हो सके। कृपया बाद में पुनः प्रयास करें या निर्माता से संपर्क करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível entrar no grupo. Tente novamente mais tarde ou contate o criador."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குழுவில் சேர முடியவில்லை. பிறகு மீண்டும் முயற்சிக்கவும் அல்லது உருவாக்குநரை தொடர்பு கொள்ளவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入群组失败，请稍后重试或联系群组创建者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入群組失敗，請稍後重試或聯絡群組建立者。"
          }
        }
      }
    },
