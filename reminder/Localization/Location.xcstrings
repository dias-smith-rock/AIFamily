{
  "sourceLanguage": "en",
  "strings": {
    "location_choose_how_long_to_hide_your_location": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مدة إخفاء موقعك"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how long to hide your location"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cuánto tiempo ocultar tu ubicación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la durée de masquage de votre position"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान छिपाने की अवधि चुनें"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha por quanto tempo ocultar sua localização"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடத்தை மறைக்கும் கால அளவைத் தேர்ந்தெடுக்கவும்"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择隐藏位置的时长"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇隱藏位置的時長"
          }
        }
      }
    },
    "location_collapse_location_sharing": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طي مشاركة الموقع"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapse location sharing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraer ubicación compartida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduire le partage de position"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान साझाकरण संक्षिप्त करें"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recolher compartilhamento de localização"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடப் பகிர்வை சுருக்கு"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起位置共享"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收起位置共享"
          }
        }
      }
    },
    "location_control_when_you_share_location_toggle_ghost_mod": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحكم في وقت مشاركة الموقع — فعّل وضع التخفي في أي وقت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control when you share location—toggle ghost mode anytime for private independence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla cuándo compartes ubicación: activa el modo fantasma cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez quand vous partagez votre position — mode fantôme en un geste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान साझा करने का समय नियंत्रित करें — कभी भी घोस्ट मोड चालू करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle quando compartilha localização — ative o modo fantasma a qualquer momento."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இடம் பகிர்வு நேரத்தைக் கட்டுப்படுத்துங்கள் — எப்போதும் மறைவு பயன்முறையை மாற்றுங்கள்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自由掌控位置共享时机，一键开启，随时切换独立隐私。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自由掌控位置共享時機，一鍵開啟，隨時切換獨立隱私。"
          }
        }
      }
    },
    "location_current_user_always_shown_on_the_map": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستخدم الحالي، يظهر دائمًا على الخريطة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current user, always shown on the map"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuario actual, siempre visible en el mapa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisateur actuel, toujours affiché sur la carte"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान उपयोगकर्ता, हमेशा मानचित्र पर दिखता है"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuário atual, sempre exibido no mapa"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தற்போதைய பயனர், வரைபடத்தில் எப்போதும் காட்டப்படும்"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前用户，始终在地图上显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前使用者，始終在地圖上顯示"
          }
        }
      }
    },
    "location_enter_live_location_mode": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدخول إلى وضع الموقع المباشر"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter live location mode"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrar al modo de ubicación en vivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer le mode position en direct"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव लोकेशन मोड में प्रवेश करें"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrar no modo de localização ao vivo"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நேரடி இடப் பகிர்வு பயன்முறைக்குள் நுழை"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入实时位置模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進入即時位置模式"
          }
        }
      }
    },
    "location_exit_live_location_mode": {
      "localizations": {
