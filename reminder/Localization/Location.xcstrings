    "location_set_location_to_always_in_settings_to_update_you": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر «دائمًا» في الإعدادات لتحديث الموقع في الخلفية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set location to Always in Settings to update your position in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige «Siempre» en Ajustes para actualizar tu ubicación en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez « Toujours » dans Réglages pour mettre à jour la position en arrière-plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पृष्ठभूमि में अपडेट के लिए सेटिंग्स में स्थान को «हमेशा» चुनें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina «Sempre» em Ajustes para atualizar a localização em segundo plano."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பின்னணியில் புதுப்பிக்க அமைப்புகளில் «எப்போதும்» என தேர்ந்தெடுக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中将位置设为「始终」，才能在后台更新位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中將位置設為「始終」，才能在背景更新位置。"
          }
        }
      }
    },
    "location_shown_on_the_map_when_selected": {
      "localizations": {
        "ar": {
