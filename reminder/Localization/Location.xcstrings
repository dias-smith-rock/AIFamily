    "location_no_location_yet_will_appear_on_the_map_when_loca": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، لا يوجد موقع بعد؛ سيظهر على الخريطة عند توفر بيانات الموقع"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, no location yet; will appear on the map when location data is available"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, sin ubicación; aparecerá en el mapa cuando haya datos de ubicación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, pas de position ; apparaîtra sur la carte lorsque des données seront disponibles"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, अभी कोई स्थान नहीं; स्थान डेटा मिलने पर मानचित्र पर दिखेगा"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, sem localização; aparecerá no mapa quando houver dados de localização"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, இன்னும் இடம் இல்லை; இடத் தரவு கிடைக்கும்போது வரைபடத்தில் காட்டப்படும்"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，暂无位置，勾选后将在有定位数据时显示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，暫無位置，勾選後將在有定位資料時顯示"
          }
        }
      }
    },
