    "schedule_upon_dismissal_all_members_will_be_removed_and_t": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الحل، ستتم إزالة جميع الأعضاء، وسيتم مسح المهام وأكواد الدعوة نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upon dismissal, all members will be removed, and tasks and invitation codes will be permanently cleared. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de la disolución, todos los miembros serán eliminados y las tareas y los códigos de invitación se borrarán permanentemente. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la dissolution, tous les membres seront supprimés et les tâches et codes d'invitation seront définitivement effacés. Cette action ne peut pas être annulée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विघटन के बाद, सभी सदस्यों को हटा दिया जाएगा, और कार्यों और निमंत्रण कोड को स्थायी रूप से साफ़ कर दिया जाएगा। इस एक्शन को वापस नहीं किया जा सकता।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a dissolução, todos os membros serão removidos e as tarefas e códigos de convite serão apagados permanentemente. Esta ação não pode ser desfeita."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கலைக்கப்பட்ட பிறகு, அனைத்து உறுப்பினர்களும் அகற்றப்படுவார்கள், மேலும் பணிகளும் அழைப்புக் குறியீடுகளும் நிரந்தரமாக அழிக்கப்படும். இந்தச் செயலைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解散后所有成员将被移除，任务与邀请码将被永久清空。此操作不可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解散後所有成員將移除，任務與邀請碼將永久清空。此操作不可撤銷。"
          }
        }
      }
    },
    "schedule_use_face_id_to_unlock_and_continue_to_your_group": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم Face ID للمتابعة والوصول إلى جداول ومهام المجموعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Face ID to unlock and continue to your group schedules and tasks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Face ID para desbloquear y continuar con tus horarios y tareas del grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Face ID pour déverrouiller et accéder à vos plannings et tâches de groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनलॉक करने और समूह के शेड्यूल व कार्यों तक पहुँचने के लिए Face ID का उपयोग करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o Face ID para desbloquear e continuar para seus horários e tarefas do grupo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குழு அட்டவணை மற்றும் பணிகளை அணுக Face ID மூலம் திறக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Face ID 解锁后继续访问你的群组日程与任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Face ID 解鎖後繼續存取你的群組日程與任務。"
          }
        }
      }
    },
    "schedule_verify_your_identity_to_access_group_schedules_a": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من هويتك للوصول إلى جداول ومهام المجموعة في WeSync."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your identity to access group schedules and tasks in WeSync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica tu identidad para acceder a los horarios y tareas del grupo en WeSync."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre identité pour accéder aux plannings et tâches de groupe dans WeSync."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "WeSync में समूह के शेड्यूल और कार्यों तक पहुँचने के लिए अपनी पहचान सत्यापित करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique sua identidade para acessar horários e tarefas do grupo no WeSync."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "WeSync இல் குழு அட்டவணை மற்றும் பணிகளை அணுக உங்கள் அடையாளத்தை சரிபார்க்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请验证身份以访问同圈中的群组日程与任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請驗證身分以存取同圈中的群組日程與任務。"
          }
        }
      }
    },
