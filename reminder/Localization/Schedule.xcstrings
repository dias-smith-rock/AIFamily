{
  "sourceLanguage": "en",
  "strings": {
    "schedule_accept_task": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبول المهمة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept task"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptar tarea"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepter la tâche"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य स्वीकार करें"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceitar tarefa"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பணியை ஏற்றுக்கொள்"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受任务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接受任務"
          }
        }
      }
    },
    "schedule_add_tasks_without_a_set_start_time_complete_them": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضِف مهامًا بلا وقت بدء محدد—أنجزها قبل الموعد النهائي."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add tasks without a set start time—complete them before the due date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tareas sin hora de inicio; complétalas antes de la fecha límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des tâches sans heure de début—à terminer avant la date limite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना शुरुआती समय के कार्य जोड़ें—अंतिम तिथि से पहले पूरा करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione tarefas sem horário de início—conclua-as antes do prazo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடக்க நேரம் இல்லாத பணிகளைச் சேர்க்கவும்—காலக்கெடுவுக்கு முன் முடிக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加没有具体开始时间的任务，在截止日前完成即可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增沒有具體開始時間的任務，在截止日前完成即可。"
          }
        }
      }
    },
    "schedule_add_the_first_member_to_share_tasks_and_gentle_d": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضِف العضو الأول لتقسيم المهام وتذكيرات لطيفة كل يوم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the first member to share tasks and gentle daily reminders together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade al primer miembro para repartir tareas y recordatorios amables cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le premier membre pour partager les tâches et des rappels bienveillants au quotidien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहला सदस्य जोड़ें—मिलकर काम बाँटें और हर दिन कोमल अनुस्मारक पाएँ।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o primeiro membro para dividir tarefas e lembretes gentis no dia a dia."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முதல் உறுப்பினரைச் சேர்த்து, பணிகளைப் பகிர்ந்து தினமும் மென்மையான நினைவூட்டல்களைப் பெறுங்கள்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加第一位成员，一起分工协作、温柔提醒每一天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增第一位成員，一起分工協作、溫柔提醒每一天。"
          }
        }
      }
    },
    "schedule_after_logging_out_you_will_not_be_able_to_view_t": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد تسجيل الخروج، لن تتمكن من عرض المهام والرسائل في المجموعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After logging out, you will not be able to view tasks and messages in the group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de cerrar sesión, no podrá ver las tareas ni los mensajes del grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après vous être déconnecté, vous ne pourrez plus afficher les tâches et les messages du groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉग आउट करने के बाद आप ग्रुप में टास्क और मैसेज नहीं देख पाएंगे."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após sair, você não poderá visualizar tarefas e mensagens no grupo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "வெளியேறிய பிறகு, குழுவில் உள்ள பணிகள் மற்றும் செய்திகளைப் பார்க்க முடியாது."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出后您将无法查看群内的任务和消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "退出後您將無法查看群組內的任務和訊息。"
          }
        }
      }
    },
    "schedule_after_removal_they_can_no_longer_access_this_gro": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وبعد الإزالة، لم يعد بإمكانهم الوصول إلى مهام هذه المجموعة أو رسائلها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After removal, they can no longer access this group's tasks or messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de la eliminación, ya no podrán acceder a las tareas ni a los mensajes de este grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la suppression, ils ne peuvent plus accéder aux tâches ou aux messages de ce groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाने के बाद, वे अब इस समूह के कार्यों या संदेशों तक नहीं पहुंच सकते।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a remoção, eles não poderão mais acessar as tarefas ou mensagens deste grupo."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அகற்றிய பிறகு, இந்தக் குழுவின் பணிகளையோ செய்திகளையோ அவர்களால் அணுக முடியாது."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移出后，该成员将无法再访问本群组的任务与信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移出後，該成員將無法再存取本群組的任務與資訊。"
          }
        }
      }
    },
    "schedule_after_the_task_is_created_it_will_appear_in_this": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد إنشاء المهمة، سوف تظهر في هذه القائمة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the task is created, it will appear in this list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez creada la tarea, aparecerá en esta lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois la tâche créée, elle apparaîtra dans cette liste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्य बनने के बाद वह इस सूची में दिखाई देगा."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois que a tarefa for criada, ela aparecerá nesta lista."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பணி உருவாக்கப்பட்ட பிறகு, அது இந்த பட்டியலில் தோன்றும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建任务后将显示在此列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立任務後將顯示在此清單。"
          }
        }
      }
    },
