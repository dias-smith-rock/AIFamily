        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全天任務提醒"
          }
        }
      }
    },
    "schedule_an_all_day_task_is_due_on_the_scheduled_date_ope": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مهمة لليوم كله مستحقة في التاريخ المجدول. افتح التطبيق لرؤية العنوان."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An all-day task is due on the scheduled date. Open the app to see the title."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarea de todo el día vence en la fecha programada. Abra la aplicación para ver el título."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche d'une journée entière est due à la date prévue. Ouvrez l'application pour voir le titre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्धारित तिथि पर पूरे दिन का कार्य होना है। शीर्षक देखने के लिए ऐप खोलें."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa de dia inteiro vence na data agendada. Abra o aplicativo para ver o título."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "திட்டமிடப்பட்ட தேதியில் ஒரு நாள் முழுவதும் வேலை செய்ய வேண்டும். தலைப்பைப் பார்க்க, பயன்பாட்டைத் திறக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一则全天任务将于约定日期到来，请在日程中查看标题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一則全天任務將於約定日期到來，請在行程中查看標題。"
          }
        }
      }
    },
    "schedule_birthday_auto_task_yearly_recurrence": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مهمة تلقائية لعيد الميلاد (تكرار سنوي)"
