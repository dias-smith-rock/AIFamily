    "schedule_ai_voice_task_creation_group_smart_weekly_report": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "AI إنشاء المهام الصوتية والتقارير الأسبوعية الجماعية الذكية والتذكيرات المتقدمة والمزيد من ميزات Pro في الطريق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI voice task creation, group smart weekly reports, advanced reminders, and more Pro features are on the way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AI creación de tareas de voz, informes semanales inteligentes grupales, recordatorios avanzados y más funciones Pro están en camino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La création de tâches vocales AI, les rapports hebdomadaires intelligents de groupe, les rappels avancés et d'autres fonctionnalités Pro sont en route."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ध्वनि कार्य निर्माण, समूह स्मार्ट साप्ताहिक रिपोर्ट, उन्नत अनुस्मारक, और अधिक Pro सुविधाएँ आने वाली हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "AI criação de tarefas de voz, relatórios semanais inteligentes de grupo, lembretes avançados e mais recursos Pro estão a caminho."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "AI குரல் பணி உருவாக்கம், குழு ஸ்மார்ட் வாராந்திர அறிக்கைகள், மேம்பட்ட நினைவூட்டல்கள் மற்றும் பல Pro அம்சங்கள் தயாராக உள்ளன."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 语音极速建任务、群组智能周报、高阶提醒规则等更多专属功能即将上线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 語音極速建任務、群組智慧週報、高階提醒規則等更多專屬功能即將上線。"
          }
        }
      }
    },
    "schedule_all_day_task_reminder": {
