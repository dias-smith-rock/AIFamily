    "schedule_couldn_t_extract_a_valid_task_from_the_photo_try": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر استخراج مهمة صالحة من الصورة. جرّب صورة أوضح أو أنشئ المهمة يدويًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't extract a valid task from the photo. Try a clearer image or create the task manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo extraer una tarea válida de la foto. Prueba una imagen más clara o créala manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'extraire une tâche valide de la photo. Essayez une image plus nette ou créez-la manuellement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो से मान्य कार्य निकाला नहीं जा सका। स्पष्ट फ़ोटो आज़माएँ या मैन्युअल रूप से बनाएँ।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível extrair uma tarefa válida da foto. Tente uma imagem mais nítida ou crie manualmente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படத்திலிருந்து ச‌ெல்லுபடியான பணியை பிரித்தெடுக்க முடியவில்லை. தெளிவான படம் முயற்சிக்கவும் அல்லது கைமுறையாக உருவாக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能从图片中提取有效任务信息，请换一张更清晰的照片或手动创建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能從圖片中提取有效任務資訊，請換一張更清晰的照片或手動建立。"
          }
        }
      }
    },
