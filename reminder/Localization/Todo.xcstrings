    },
    "todo_clear_trash_confirm_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف نهائيًا كل المهام المتأخرة والمحذوفة. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All overdue and deleted to-dos will be permanently removed. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán permanentemente todas las tareas vencidas y eliminadas. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les tâches en retard et supprimées seront définitivement retirées. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी अतिदेय और हटाए गए टू-डू स्थायी रूप से हटा दिए जाएंगे। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os afazeres atrasados e excluídos serão removidos permanentemente. Esta ação não pode ser desfeita."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "காலாவதியான மற்றும் நீக்கப்பட்ட அனைத்து பணிகளும் நிரந்தரமாக நீக்கப்படும். இதை செயல்தவிர்க்க முடியாது."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将永久删除所有过期与已删除的待办，此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將永久刪除所有過期與已刪除的待辦，此操作無法撤銷。"
          }
        }
      }
    },
