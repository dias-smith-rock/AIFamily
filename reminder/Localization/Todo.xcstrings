            "value": "Tout afficher"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी कार्य फिट करें"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar todos os afazeres"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அனைத்தையும் பொருத்து"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
