          }
        }
      }
    },
    "settings_delete_account_creator_block": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت منشئ %@ و%lld مجموعات أخرى. يُرجى نقل الملكية أو حلّ تلك المجموعات قبل حذف حسابك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are the creator of %2$lld group(s) including '%1$@'. Please transfer ownership or dismiss the groups before deleting your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres el creador de %@ y de %lld grupos más. Transfiere la propiedad o disuelve esos grupos antes de eliminar tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes le créateur de %@ et de %lld autres groupes. Veuillez transférer la propriété ou dissoudre ces groupes avant de supprimer votre compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप %@ सहित %lld अन्य समूहों के निर्माता हैं। कृपया खाता हटाने से पहले स्वामित्व स्थानांतरित करें या उन समूहों को भंग करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você é o criador de %@ e de mais %lld grupos. Transfira a propriedade ou dissolva esses grupos antes de excluir sua conta."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் %@ உட்பட மேலும் %lld குழுக்களின் உருவாக்குநர். கணக்கை நீக்குவதற்கு முன் உரிமையை மாற்றவும் அல்லது அந்தக் குழுக்களை கலைக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您是「%@」等 %lld 个群组的创建者，请先转移权限或解散群组后再注销账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您是「%@」等 %lld 個群組的創建者，請先轉移權限或解散群組後再登出帳戶。"
          }
        }
      }
    },
