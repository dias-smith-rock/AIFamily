{
  "sourceLanguage" : "en",
  "strings" : {
    "settings_location_ghost_footer" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثناء الإخفاء، لا تُرسل إحداثيات جديدة إلى الخادم. لا يزال بإمكان أعضاء المجموعة رؤية آخر موقع أبلغت عنه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While hidden, new coordinates are not sent to the server. Group members can still see your last reported location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras esté oculto, no se envían nuevas coordenadas al servidor. Los miembros del grupo aún pueden ver su última ubicación reportada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant que vous êtes masqué, aucune nouvelle coordonnée n'est envoyée au serveur. Les membres du groupe voient toujours votre dernière position signalée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छिपे रहने पर नए निर्देशांक सर्वर पर नहीं भेजे जाते। समूह के सदस्य आपका अंतिम रिपोर्ट किया स्थान अभी भी देख सकते हैं।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto oculto, novas coordenadas não são enviadas ao servidor. Os membros do grupo ainda podem ver sua última localização reportada."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மறைத்திருக்கும் போது புதிய ஆயத்தொலைவுகள் சேவையகத்திற்கு அனுப்பப்படாது. குழு உறுப்பினர்கள் உங்கள் கடைசியாக அறிவித்த இடத்தை இன்னும் காணலாம்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐身期间不会向服务器上报新坐标，群组成员仍可看到您上次上报的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隱身期間不會向伺服器上報新座標，群組成員仍可看到您上次上報的位置。"
          }
        }
      }
    },
    "settings_location_ghost_toggle" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
