            "value" : "Limite de deslocamento"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இடப்பெயர்வு வரம்பு"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位移阈值"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位移閾值"
          }
        }
      }
    },
    "settings_location_reporting_history_count_footer" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤثر فقط على عدد نقاط المسار والسجل المعروضة على الخريطة. سجلات الموقع المخزنة في السحابة لا تتغير."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only affects how many trail and history points are shown on the map. Cloud-stored location records are unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo afecta cuántos puntos de ruta e historial se muestran en el mapa. Los registros de ubicación en la nube no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'affecte que le nombre de points de trajet et d'historique affichés sur la carte. Les enregistrements de position dans le cloud restent inchangés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल मानचित्र पर दिखाए जाने वाले ट्रेल और इतिहास बिंदुओं की संख्या को प्रभावित करता है। क्लाउड में संग्रहीत स्थान रिकॉर्ड अपरिवर्तित रहते हैं।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afeta apenas quantos pontos de trilha e histórico são exibidos no mapa. Os registros de localização na nuvem permanecem inalterados."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வரைபடத்தில் காட்டப்படும் பாதை மற்றும் வரலாற்று புள்ளிகளின் எண்ணிக்கையை மட்டுமே பாதிக்கிறது. கிளவுடில் சேமிக்கப்பட்ட இடம் பதிவுகள் மாறாது."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅影响地图上显示的轨迹与历史点数量，不会改变云端存储的位置记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅影響地圖上顯示的軌跡與歷史點數量，不會改變雲端儲存的位置記錄。"
          }
        }
      }
    },
    "settings_location_reporting_history_count_section" : {
