          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வரலாறு காட்சி எண்ணிக்கை"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "历史位置数量"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歷史位置數量"
          }
        }
      }
    },
    "settings_location_reporting_interval_footer" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنشأ سجل موقع جديد عند تحقق حدّي الإزاحة والفاصل الزمني معًا. إذا انقضى الفاصل فقط دون إزاحة كافية، يُحدَّث أحدث سجل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new location record is created when both movement and interval thresholds are met. If only the interval elapses without enough movement, the most recent record is updated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se crea un nuevo registro de ubicación cuando se cumplen el umbral de desplazamiento y el intervalo. Si solo transcurre el intervalo sin suficiente movimiento, se actualiza el registro más reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nouvel enregistrement de position est créé lorsque les seuils de déplacement et d'intervalle sont atteints. Si seul l'intervalle s'écoule sans mouvement suffisant, l'enregistrement le plus récent est mis à jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब स्थानांतरण और अंतराल दोनों सीमाएँ पूरी होती हैं तो एक नया स्थान रिकॉर्ड बनता है। यदि पर्याप्त गति के बिना केवल अंतराल पूरा होता है, तो सबसे हाल का रिकॉर्ड अपडेट होता है।"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um novo registro de localização é criado quando os limites de deslocamento e intervalo são atingidos. Se apenas o intervalo passar sem movimento suficiente, o registro mais recente é atualizado."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இடப்பெயர்வு மற்றும் இடைவெளி வரம்புகள் இரண்டும் பூர்த்தியாகும்போது புதிய இடம் பதிவு உருவாக்கப்படும். போதுமான இடப்பெயர்வு இல்லாமல் இடைவெளி மட்டும் முடிந்தால், சமீபத்திய பதிவு புதுப்பிக்கப்படும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位移与间隔均达标时会新增一条位置记录；仅间隔到达而位移未达阈值时，会更新最近一条位置记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位移與間隔均達標時會新增一條位置記錄；僅間隔到達而位移未達閾值時，會更新最近一條位置記錄。"
          }
        }
      }
    },
