          }
        }
      }
    },
    "vip_free_plan_allows_1_compressed_image_per_task_upg": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخطة المجانية تسمح بصورة مضغوطة واحدة لكل مهمة. قم بالترقية إلى Pro للمزيد وجودة أعلى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free plan allows 1 compressed image per task. Upgrade to Pro for more and higher quality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan gratuito permite 1 imagen comprimida por tarea. Actualiza a Pro para más y mejor calidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan gratuit permet 1 image compressée par tâche. Passez à Pro pour plus et une meilleure qualité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मुफ्त योजना में प्रति कार्य 1 संपीड़ित छवि। अधिक और बेहतर गुणवत्ता के लिए Pro में अपग्रेड करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano gratuito permite 1 imagem comprimida por tarefa. Atualize para Pro para mais e melhor qualidade."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இலவச திட்டம் ஒரு பணிக்கு 1 சுருக்கப்பட்ட படம். Pro-க்கு மேம்படுத்தவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费版每任务仅支持 1 张压缩图片，升级 Pro 后可添加更多并支持更高画质。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費版每任務僅支援 1 張壓縮圖片，升級 Pro 後可新增更多並支援更高畫質。"
          }
        }
      }
    },
    "vip_free_plan_allows_1_compressed_image_per_task_upg_2": {
