{
  "sourceLanguage": "en",
  "strings": {
    "vip_app_store_subscriptions_are_coming_soon_stay_tun": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراكات App Store قريبًا. ترقبوا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store subscriptions are coming soon. Stay tuned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones en App Store llegarán pronto. Permanece atento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnements App Store arrivent bientôt. Restez à l'écoute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store सब्सक्रिप्शन जल्द आ रहा है। बने रहें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assinaturas na App Store em breve. Fique atento."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store சந்தா விரைவில் வருகிறது. காத்திருங்கள்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 订阅功能即将上线，敬请期待。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 訂閱功能即將上線，敬請期待。"
          }
        }
      }
    },
    "vip_choose_a_plan": {
