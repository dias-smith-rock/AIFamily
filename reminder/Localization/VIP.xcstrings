    "vip_founding_member_offer_claim_1_year_of_pro_free_f": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "🚀 عرض العضو المؤسس: احصل على سنة واحدة من Pro مجانًا لفترة محدودة!"
