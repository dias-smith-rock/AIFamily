        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கிளவுட் ஒத்திசைவை மீண்டும் முயற்சி"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试云端同步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重試雲端同步"
          }
        }
      }
    },
