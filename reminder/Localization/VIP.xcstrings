          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "🚀 ஸ்தாபக உறுப்பினர் சலுகை: குறிப்பிட்ட காலத்திற்கு Pro 1 வருடத்தை இலவசமாகப் பெறுங்கள்!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
