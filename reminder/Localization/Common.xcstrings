    "common_there_was_a_problem_uploading_the_photo_please_t": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدثت مشكلة في رفع الصورة. يرجى المحاولة مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There was a problem uploading the photo. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubo un problema al subir la foto. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu lors de l'envoi de la photo. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो अपलोड करने में समस्या हुई। कृपया पुनः प्रयास करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um problema ao enviar a foto. Tente novamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "புகைப்படம் பதிவேற்றுவதில் சிக்கல் ஏற்பட்டது. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片上传异常，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片上傳異常，請重試。"
          }
        }
      }
    },
    "common_this_action_cannot_be_undone": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action ne peut pas être annulée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस एक्शन को वापस नहीं किया जा सकता।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação não pode ser desfeita."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தச் செயலைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不可撤銷。"
          }
        }
