    "common_from_chaos_to_clarity_together_perfectly_synced": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقويم ومهام العائلة المشتركة.\nالتوصيل والمهام ومن المسؤول."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared family calendar & to-dos.\nPickups, chores, and who's on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario y tareas familiares.\nRecogidas, tareas y quién se encarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenda et tâches familiales.\nTrajets, corvées : qui s’en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिवार का साझा कैलेंडर और कार्य।\nपिकअप, काम और ज़िम्मेदारी साफ़।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendário e tarefas da família.\nBuscas, tarefas e quem cuida."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "குடும்பப் பகிர்வு நாட்காட்டி & பணிகள்.\nபிக்கப், வேலைகள்—யார் பொறுப்பு தெளிவு."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家庭共享日历与待办。\n接送、家务，谁负责一目了然。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家庭共享日曆與待辦。\n接送、家務，誰負責一目了然。"
          }
        }
      }
    },
