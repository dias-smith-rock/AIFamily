      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصحيح اللغة الطبيعية: على سبيل المثال. \"تغيير الوقت إلى بعد ظهر الغد\""
