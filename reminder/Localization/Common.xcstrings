        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकएंड अपग्रेड की आवश्यकता है. कृपया नवीनतम Supabase माइग्रेशन लागू करें और पुनः प्रयास करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualização de back-end necessária. Aplique a migração Supabase mais recente e tente novamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பின்தள மேம்படுத்தல் தேவை. சமீபத்திய Supabase நகர்த்தலைப் பயன்படுத்தி, மீண்டும் முயற்சிக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后端尚未完成升级，请先执行最新 Supabase migration 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "後端尚未完成升級，請先執行最新 Supabase migration 後重試。"
