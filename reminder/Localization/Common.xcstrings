    "common_backend_upgrade_required_please_apply_the_latest": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب ترقية الواجهة الخلفية. الرجاء تطبيق أحدث ترحيل Supabase والمحاولة مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backend upgrade required. Please apply the latest Supabase migration and try again."
          }
