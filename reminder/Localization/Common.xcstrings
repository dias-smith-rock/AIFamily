    "common_remember_to_check_your_refrigerator_inventory_on": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكر التحقق من مخزون ثلاجتك صباح يوم السبت ومزامنتها مع قائمة التسوق المشتركة لهذا الأسبوع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember to check your refrigerator inventory on Saturday morning and sync up with your shared shopping list for the week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuerde revisar el inventario de su refrigerador el sábado por la mañana y sincronizarlo con su lista de compras compartida de la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'oubliez pas de vérifier l'inventaire de votre réfrigérateur le samedi matin et de vous synchroniser avec votre liste de courses partagée pour la semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शनिवार की सुबह अपने रेफ्रिजरेटर की सूची की जांच करना और सप्ताह के लिए अपनी साझा खरीदारी सूची के साथ समन्वय करना याद रखें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembre-se de verificar o estoque de sua geladeira no sábado de manhã e sincronizar sua lista de compras compartilhada da semana."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "சனிக்கிழமை காலை உங்கள் குளிர்சாதனப் பெட்டி இருப்பை சரிபார்த்து, வாரத்திற்கான உங்கள் பகிரப்பட்ட ஷாப்பிங் பட்டியலுடன் ஒத்திசைக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记得在周六上午检查冰箱库存，并同步更新本周的共享购物清单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記得在周六上午檢查冰箱庫存，並同步更新本週的共享購物清單。"
          }
        }
      }
    },
