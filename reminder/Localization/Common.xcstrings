    "common_what_would_you_like_to_do": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا تريد أن تفعل؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to do?"
          }
        },
        "es": {
          "stringUnit": {
