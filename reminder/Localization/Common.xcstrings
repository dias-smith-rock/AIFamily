          "stringUnit": {
            "state": "translated",
            "value": "प्राकृतिक भाषा सुधार: उदा. \"समय बदलकर कल दोपहर कर दें\""
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Correção de linguagem natural: por ex. \"Mude o horário para amanhã à tarde\""
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயற்கை மொழி திருத்தம்: எ.கா. \"நாளை மதியத்திற்கு நேரத்தை மாற்றவும்\""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自然语言修正：例如“时间改成明天下午”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自然語言修正：例如“時間改成明天下午”"
