    "common_the_image_isn_t_ready_yet_try_again_in_a_moment": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصورة غير جاهزة بعد. حاول مرة أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image isn't ready yet. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen aún no está lista. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image n'est pas prête. Réessayez dans un instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छवि अभी तैयार नहीं। बाद में पुनः प्रयास करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem ainda não está pronta. Tente novamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "படம் இன்னும் தயாராகவில்லை. சிறிது நேரம் கழித்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片尚未加载完成，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片尚未載入完成，請稍後再試。"
          }
        }
      }
    },
