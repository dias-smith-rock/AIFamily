    "common_once_you_select_a_look_and_feel_the_app_immediat": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بمجرد تحديد الشكل والمظهر، يقوم التطبيق على الفور بتبديل أوضاع العرض."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you select a look and feel, the app immediately switches display modes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez que selecciona una apariencia, la aplicación cambia inmediatamente los modos de visualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois que vous avez sélectionné une apparence, l’application change immédiatement de mode d’affichage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार जब आप लुक और फील का चयन कर लेते हैं, तो ऐप तुरंत डिस्प्ले मोड स्विच कर देता है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de selecionar uma aparência, o aplicativo muda imediatamente os modos de exibição."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தோற்றத்தையும் உணர்வையும் நீங்கள் தேர்ந்தெடுத்ததும், ஆப்ஸ் உடனடியாக காட்சி முறைகளை மாற்றுகிறது."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择外观后，应用会立即切换显示模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇外觀後，應用程式會立即切換顯示模式。"
          }
        }
      }
    },
