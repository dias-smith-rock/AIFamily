    "common_your_join_request_has_been_submitted_please_wait": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد تم تقديم طلب الانضمام الخاص بك. الرجاء الانتظار لموافقة المشرف."
          }
        },
        "en": {
