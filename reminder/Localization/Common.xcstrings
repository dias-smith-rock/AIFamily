    "common_double_tap_for_full_screen_swipe_left_or_right_t": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر نقرًا مزدوجًا لملء الشاشة. اسحب لليسار أو لليمين للتبديل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double tap for full screen. Swipe left or right to switch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para ver la pantalla completa. Desliza hacia la izquierda o hacia la derecha para cambiar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez deux fois pour passer en plein écran. Faites glisser votre doigt vers la gauche ou la droite pour changer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण स्क्रीन के लिए दो बार टैप करें. स्विच करने के लिए बाएँ या दाएँ स्वाइप करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes para tela cheia. Deslize para a esquerda ou para a direita para alternar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "முழுத் திரைக்கு இருமுறை தட்டவும். மாற இடது அல்லது வலது ஸ்வைப் செய்யவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点以全屏查看，可左右滑动切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點以全螢幕查看，可左右滑動切換"
          }
        }
      }
    },
