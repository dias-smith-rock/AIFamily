    "common_trial_data_on_this_device_will_be_deleted_and_ca": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف بيانات التجربة على هذا الجهاز ولا يمكن استعادتها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trial data on this device will be deleted and cannot be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán los datos de prueba del dispositivo y no se podrán recuperar."
          }
