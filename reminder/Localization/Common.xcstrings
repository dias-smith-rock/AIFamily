    "common_after_adjusting_the_font_size_the_text_in_the_ap": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد ضبط حجم الخط، سيتم تكبير النص الموجود في التطبيق أو تصغيره في وقت واحد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After adjusting the font size, the text in the app will be enlarged or reduced simultaneously."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de ajustar el tamaño de fuente, el texto de la aplicación se ampliará o reducirá simultáneamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir ajusté la taille de la police, le texte de l'application sera agrandi ou réduit simultanément."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ॉन्ट आकार समायोजित करने के बाद, ऐप में टेक्स्ट एक साथ बड़ा या छोटा हो जाएगा।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após ajustar o tamanho da fonte, o texto do aplicativo será ampliado ou reduzido simultaneamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "எழுத்துரு அளவை சரிசெய்த பிறகு, பயன்பாட்டில் உள்ள உரை ஒரே நேரத்தில் பெரிதாக்கப்படும் அல்லது குறைக்கப்படும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整字体大小后，应用内文字会同步放大或缩小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "調整字體大小後，應用程式內文字會同步放大或縮小。"
          }
        }
      }
    },
    "common_after_changing_the_theme_the_app_switches_displa": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد تغيير السمة، يبدّل التطبيق وضع العرض فورًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After changing the theme, the app switches display mode instantly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cambiar el tema, la app cambia el modo de visualización al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir changé le thème, l’app bascule instantanément le mode d’affichage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थीम बदलने के बाद, ऐप तुरंत प्रदर्शन मोड बदल देता है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao alterar o tema, o app muda o modo de exibição instantaneamente."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தீம் மாற்றிய பிறகு, ஆப் உடனடியாக காட்சி முறையை மாற்றும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改主题后，应用会立即切换显示模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改主題後，App 會立即切換顯示模式。"
          }
        }
      }
    },
    "common_after_pasting_sig_call_consume_invite_link_to_qu": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد لصق Sig، اتصل بـ Consumer-invite-link للتحقق سريعًا من حالة 200/409/410."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After pasting sig, call consume-invite-link to quickly verify the 200/409/410 status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de pegar la firma, llame a consume-invite-link para verificar rápidamente el estado del 200/409/410."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir collé la signature, appelez consumer-invite-link pour vérifier rapidement l'état 200/409/410."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हस्ताक्षर चिपकाने के बाद, 200/409/410 स्थिति को तुरंत सत्यापित करने के लिए कंज्यूम-इनवाइट-लिंक पर कॉल करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de colar o sinal, chame o link de consumo para verificar rapidamente o status 200/409/410."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
