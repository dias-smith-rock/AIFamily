          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que souhaitez-vous faire ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप क्या करना चाहेंगे?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você gostaria de fazer?"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் என்ன செய்ய விரும்புகிறீர்கள்?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备做什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準備做什麼？"
          }
        }
      }
    },
    "common_what_would_you_like_to_do_for_example_tomorrow_a": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا تريد أن تفعل؟ على سبيل المثال: غدًا بعد الظهر اصطحب الأطفال إلى طبيب الأسنان…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to do? For example: tomorrow afternoon take the kids to the dentist…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué te gustaría hacer? Por ejemplo: mañana por la tarde llevar a los niños al dentista…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que souhaitez-vous faire ? Par exemple : demain après-midi emmener les enfants chez le dentiste…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप क्या करना चाहेंगे? उदाहरण: कल दोपहर बच्चों को दंत चिकित्सक के पास ले जाएँ…"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você gostaria de fazer? Por exemplo: amanhã à tarde levar as crianças ao dentista…"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் என்ன செய்ய விரும்புகிறீர்கள்? உதாரணம்: நாளை மதியம் குழந்தைகளை பல் மருத்துவரிடம் அழைத்துச் செல்ல…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备做什么？可以说：明天下午花 500 港币带老大去洗牙……"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準備做什麼？可以說：明天下午花 500 港幣帶老大去洗牙……"
          }
        }
      }
    },
