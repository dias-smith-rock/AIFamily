    "common_upload_failed_storage_permissions_are_not_config": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل الرفع: لم يتم تكوين أذونات التخزين. اطلب من المسؤول إضافة سياسات الكتابة لح bucket create-task-from-images في Supabase."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload failed: storage permissions are not configured on the server. Ask an admin to add write policies for the create-task-from-images bucket in Supabase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al subir: permisos de almacenamiento no configurados. Pide al administrador añadir políticas de escritura para el bucket create-task-from-images en Supabase."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'envoi : permissions de stockage non configurées. Demandez à l'administrateur d'ajouter des règles d'écriture pour le bucket create-task-from-images dans Supabase."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपलोड विफल: सर्वर स्टोरेज अनुमति कॉन्फ़िग नहीं है। Supabase में create-task-from-images बकेट के लिए लेखन नीति जोड़ने को कहें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha no envio: permissões de armazenamento não configuradas. Peça ao administrador para adicionar políticas de gravação do bucket create-task-from-images no Supabase."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பதிவேற்றம் தோல்வி: சேமிப்பக அனுமதி அமைக்கப்படவில்லை. Supabase-ல் create-task-from-images bucket-க்கு எழுத்து கொள்கையை சேர்க்க Admin-ஐ தொடர்பு கொள்ளுங்கள்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片上传失败，服务器存储权限未配置。请联系管理员在 Supabase 为 create-task-from-images 桶添加写入策略。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片上傳失敗，伺服器儲存權限未設定。請聯絡管理員在 Supabase 為 create-task-from-images 桶新增寫入策略。"
          }
        }
      }
    },
