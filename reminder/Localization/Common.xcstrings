        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस का परीक्षण डेटा हटा दिया जाएगा और पुनर्प्राप्त नहीं किया जा सकता।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados de avaliação neste dispositivo serão excluídos e não poderão ser recuperados."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த சாதனத்தின் சோதனை தரவு நீக்கப்படும்; மீட்டெடுக்க முடியாது."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除本机试用数据，且无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除本機試用資料，且無法復原。"
