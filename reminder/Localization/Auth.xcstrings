    "auth_please_log_in_first_before_using_ai_to_create_a": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى تسجيل الدخول أولاً قبل استخدام AI لإنشاء مهمة للتعرف على الصور."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please log in first before using AI to create a task for image recognition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sesión primero antes de usar AI para crear una tarea de reconocimiento de imágenes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez d'abord vous connecter avant d'utiliser AI pour créer une tâche de reconnaissance d'image."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छवि पहचान के लिए कार्य बनाने के लिए AI का उपयोग करने से पहले कृपया लॉग इन करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login primeiro antes de usar AI para criar uma tarefa para reconhecimento de imagem."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ஐப் பயன்படுத்துவதற்கு முன் முதலில் உள்நுழையவும், படத்தை அறிதலுக்கான பணியை உருவாக்கவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先登录后再使用 AI 识图创建任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先登入後再使用 AI 識圖建立任務。"
          }
        }
      }
    },
