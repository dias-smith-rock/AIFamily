    "auth_send_an_invite_link_so_they_can_sign_in_on_their": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل رابط دعوة ليتمكنوا من تسجيل الدخول على هواتفهم والمشاركة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send an invite link so they can sign in on their phone and participate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un enlace de invitación para que puedan iniciar sesión en su teléfono y participar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez un lien d'invitation pour qu'ils puissent se connecter sur leur téléphone et participer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आमंत्रण लिंक भेजें ताकि वे अपने फ़ोन पर साइन इन कर सकें और भाग ले सकें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie um link de convite para que possam entrar no celular e participar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "அவர்கள் தங்கள் தொலைபேசியில் உள்நுழைந்து பங்கேற்க அழைப்பு இணைப்பை அனுப்பவும்."
          }
        },
        "zh-Hans": {
