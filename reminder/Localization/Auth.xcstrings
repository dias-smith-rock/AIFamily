    "auth_your_data_is_stored_on_this_device_only_sign_in": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البيانات محفوظة على هذا الجهاز فقط. سجّل الدخول للمزامنة مع السحابة والتعاون مع العائلة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is stored on this device only. Sign in to sync to the cloud and collaborate with family."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos solo se guardan en este dispositivo. Inicia sesión para sincronizar en la nube y colaborar con tu familia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données sont stockées uniquement sur cet appareil. Connectez-vous pour les synchroniser dans le cloud et collaborer en famille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा केवल इस डिवाइस पर है। क्लाउड में सिंक और परिवार के साथ सहयोग के लिए लॉग इन करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados ficam apenas neste dispositivo. Faça login para sincronizar na nuvem e colaborar com a família."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தரவு இந்த சாதனத்தில் மட்டுமே சேமிக்கப்படுகிறது. கிளவுடில் ஒத்திசைக்கவும் குடும்பத்துடன் இணைந்து பணியாற்ற உள்நுழையவும்."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前数据仅保存在本机。登录后可同步到云端，并与家人协作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前資料僅儲存在本機。登入後可同步至雲端，並與家人協作。"
          }
        }
      }
    },
