---
import type { Locale } from "../i18n/ui";
import { getMessages, localeLabels, localePath, locales, productName, site } from "../i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getMessages(locale);
const brand = productName(locale);
const pathAfterLocale = Astro.url.pathname
  .replace(/^\/(zh-Hans|zh-Hant)(?=\/|$)/, "")
  .replace(/\/$/, "") || "";
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href={localePath(locale)}>{brand}</a>

    <div class="nav__actions">
      <label class="nav__lang">
        <span class="sr-only">Language</span>
        <select
          aria-label="Language"
          onchange="window.location.href=this.value"
        >
          {
            locales.map((loc) => (
              <option
                value={localePath(loc, pathAfterLocale)}
                selected={loc === locale}
              >
                {localeLabels[loc]}
              </option>
            ))
          }
        </select>
      </label>
      <a class="btn btn--ghost" href={site.appUrl}>{t.navWeb}</a>
      <a class="btn btn--solid" href={site.appStoreUrl}>{t.navGetApp}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(14px);
    background: rgba(243, 246, 249, 0.78);
    border-bottom: 1px solid var(--line);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
  }

  .nav__brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav__lang select {
    appearance: none;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    padding: 0.45rem 0.85rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.5rem 0.95rem;
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .btn--ghost {
    color: var(--ink-soft);
  }

  .btn--solid {
    background: var(--ink);
    color: white;
  }

  @media (max-width: 720px) {
    .btn--ghost {
      display: none;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>
