SUPABASE_URL=https://dirgcwziayipwvwztjbb.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
INVITE_JWT_SECRET=replace_with_long_random_secret_at_least_32_chars
INVITE_BASE_URL=https://aifamily.app/invite
# Project settings → Secret API keys（sk_...，勿与 Info.plist 的 appl_... 混用）
REVENUECAT_SECRET_API_KEY=sk_your_revenuecat_secret_key
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer your_webhook_shared_secret
# APNs Token auth（AuthKey_XXXXX.p8）；P8 可用整段 PEM 或去掉头尾后的单行 base64
APNS_KEY_ID=your_key_id
APNS_TEAM_ID=your_team_id
APNS_BUNDLE_ID=com.aifamilygroup.reminder
APNS_P8=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
